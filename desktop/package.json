{
  "name": "irouter-desktop",
  "productName": "iRouter",
  "version": "0.3.0",
  "private": true,
  "description": "iRouter — 9Router 的跨平台桌面版（Electron 壳层，网关源码基于上游 v0.5.81 定制）",
  "main": "main.js",
  "author": "kevinjoy89 <kevinjoy89@126.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinjoy89/iRouter.git"
  },
  "homepage": "https://github.com/kevinjoy89/iRouter#readme",
  "scripts": {
    "build-server": "node scripts/build-server.mjs",
    "dev": "npm run build-server && electron .",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "test:import": "node scripts/test-import.mjs",
    "test:instance": "node scripts/test-single-instance.mjs",
    "dist:mac": "npm run build-server && node scripts/package.mjs --mac --arm64 --x64",
    "dist:win": "npm run build-server && node scripts/package.mjs --win --x64",
    "dist:linux": "npm run build-server && node scripts/package.mjs --linux --x64"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
