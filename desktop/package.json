{
  "name": "irouter-desktop",
  "productName": "iRouter",
  "version": "0.0.8",
  "private": true,
  "description": "iRouter — 9Router 的跨平台独立桌面版（Electron 壳层，网关源码基于上游 v0.5.69 定制）",
  "main": "main.js",
  "author": "iRouter",
  "license": "MIT",
  "scripts": {
    "build-server": "node scripts/build-server.mjs",
    "dev": "npm run build-server && electron .",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "test:import": "node scripts/test-import.mjs",
    "test:instance": "node scripts/test-single-instance.mjs",
    "dist:mac": "npm run build-server && node scripts/package.mjs --mac",
    "dist:win": "npm run build-server && node scripts/package.mjs --win",
    "dist:linux": "npm run build-server && node scripts/package.mjs --linux"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
