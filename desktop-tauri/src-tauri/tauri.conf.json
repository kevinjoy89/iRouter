{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iRouter",
  "version": "0.4.2",
  "identifier": "com.irouter.desktop",
  "mainBinaryName": "iRouter",
  "build": {
    "frontendDist": "../dist",
    "beforeBundleCommand": "node scripts/stage-sidecar.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "iRouter 本地智能网关",
    "longDescription": "本地 AI 路由网关：对外只暴露一个 OpenAI 兼容端点，把请求分发到 40+ 上游提供商，支持模型组合回退、多账号回退、OAuth/API Key 凭据管理、用量统计与可选云同步。",
    "targets": [
      "dmg",
      "nsis",
      "deb"
    ],
    "externalBin": [
      "binaries/irouter-bun"
    ],
    "resources": {
      "../../build/gateway/server/": "gateway/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
